    {
     "module": "conformance.catalog_base",
     "extends": "conformance.sales.Customer",
     "entity": {"meaning": "A customer of the company", "label": {"und": "Customer"}, "key": ["name"]},
     "elements": [
      {"name": "name", "kind": "field", "value_type": "str", "required": true, "label": {"und": "Name"},
       "sensitivity": "personal", "ext": {"ui.width": 40}},
      {"name": "credit_limit", "kind": "field", "value_type": "decimal", "unit": "currency:company",
       "meaning": "The credit limit in force"}
     ]
    }
   ]
  },
  "conformance.catalog_sales": {
   "name": "conformance.catalog_sales",
   "version": "1",
   "depends": ["conformance.catalog_base"],
   "extensions": [
    {
     "module": "conformance.catalog_sales",
     "extends": "conformance.sales.OrderLine",
     "entity": {"meaning": "A product included in an order, with the agreed terms"},
     "elements": [
      {"name": "order", "target": "conformance.sales.Order", "inverse": "lines", "cardinality": "one",
       "inverse_cardinality": "many", "ordered": true},
      {"name": "product", "target": "conformance.sales.Product", "cardinality": "one", "index_by": ["order.date"],
       "binding": "version"},
      {"name": "quantity", "kind": "field", "value_type": "decimal", "required": true, "unit": "unit:product"},
      {"name": "price", "kind": "field", "value_type": "decimal", "required": true, "unit": "currency:order",
       "meaning": "The unit price agreed at the sale; not the product's current price",
       "caveats": "Taxes are not included"},
      {"name": "amount", "kind": "computed", "expression": {"ast": ["*", ["attr", "quantity"], ["attr", "price"]]}}
     ]
    },
    {
     "module": "conformance.catalog_sales",
     "extends": "conformance.sales.Order",
     "entity": {"meaning": "A customer's order; open, confirmed or cancelled", "label": {"und": "Order"},
                "synonyms": ["purchase order"], "key": ["customer", "number"]},
     "elements": [
      {"name": "number", "kind": "field", "value_type": "int", "required": true, "label": {"und": "Number"},
       "meaning": "Sequential per customer, assigned at creation", "examples": [1001]},
      {"name": "state", "kind": "field", "value_type": "str", "values": ["open", "confirmed", "cancelled"],
       "default": "open"},
      {"name": "date", "kind": "field", "value_type": "date", "indexed": true},
      {"name": "customer", "target": "conformance.sales.Customer", "inverse": "orders", "cardinality": "one",
       "inverse_cardinality": "many"},
      {"name": "lines", "target": "conformance.sales.OrderLine", "inverse": "order", "cardinality": "many",
       "inverse_cardinality": "one", "ordered": true},
      {"name": "total", "kind": "computed_stored", "unit": "currency:order",
       "expression": {"ast": ["sum", "lines", ["attr", "amount"]]}},
      {"name": "add_line", "meaning": "Add a product to the order with an agreed quantity and price",
       "parameters": [["product", "conformance.sales.Product"], ["quantity", "decimal"], ["price", "decimal"]],
       "commutes_with": ["add_line"]},
      {"name": "confirm", "meaning": "Confirm the order; it accepts no new lines afterwards",
       "requires": {"ast": ["==", ["attr", "state"], ["const", "open"]]}}
     ]
    },
    {
     "module": "conformance.catalog_sales",
     "extends": "conformance.sales.RushOrder",
     "entity": {"meaning": "An order delivered before the others", "label": {"und": "Rush order"},
                "supertypes": ["conformance.sales.Order"]},
     "elements": [
      {"name": "priority", "kind": "field", "value_type": "int"}
     ]
    },
    {
     "module": "conformance.catalog_sales",
     "extends": "conformance.sales.Customer",
     "elements": [
      {"name": "credit_limit", "kind": "field", "value_type": "decimal", "label": {"und": "Credit limit"}},
      {"name": "orders", "target": "conformance.sales.Order", "inverse": "customer", "cardinality": "many",
       "inverse_cardinality": "one"},
      {"name": "committed", "kind": "computed_stored", "unit": "currency:company",
       "expression": {"ast": ["sum", "orders", ["attr", "total"], ["!=", ["attr", "state"], ["const", "cancelled"]]]}},
      {"name": "credit_limit_respected", "scope": "aggregate",
       "expression": {"ast": ["<=", ["attr", "committed"], ["attr", "credit_limit"]]},
       "meaning": "A customer cannot have orders above its credit limit",
       "message": "The order exceeds the credit limit of {entity} by {excess}"}
     ]
    }
   ]
  }
 },
